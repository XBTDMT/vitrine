    "Some arrays (%@) hold Python objects. NumPy can only load them by unpickling, which can run code; open this file only if you trust where it came from." : {
      "comment" : "NumPy archive danger warning. The argument is a list of array names.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Arrays (%@) enthalten Python-Objekte. NumPy kann sie nur durch Unpickling laden, was Code ausführen kann; öffne diese Datei nur, wenn du ihrer Herkunft vertraust."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains tableaux (%@) contiennent des objets Python. NumPy ne peut les charger qu’en les désérialisant (unpickling), ce qui peut exécuter du code ; n’ouvrez ce fichier que si vous faites confiance à sa provenance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の配列（%@）にPythonオブジェクトが含まれています。NumPyはアンピックルでしか読み込めず、その際にコードが実行される可能性があります。入手元を信頼できる場合にのみ開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 배열(%@)에 Python 객체가 들어 있습니다. NumPy는 언피클링으로만 불러올 수 있고, 이때 코드가 실행될 수 있습니다. 출처를 신뢰할 때만 이 파일을 여세요."
          }
        }
      }
    },
    "Some pages are encrypted; they cannot be shown without the password." : {
      "comment" : "Book or comic card warning.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Seiten sind verschlüsselt; ohne Passwort können sie nicht angezeigt werden."
          }
        },
        "fr" : {
