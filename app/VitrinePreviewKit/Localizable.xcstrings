    "The Claude app's settings file changed after the change was shown. Nothing was written; look again." : {
      "comment" : "Error connecting Vitrine to the Claude app: the file changed meanwhile.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
