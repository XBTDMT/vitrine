    "The depends_on entries form a loop, so Compose cannot start these services." : {
      "comment" : "Infra card warning on a Compose file; depends_on is a Compose key, kept as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die depends_on-Einträge bilden eine Schleife, daher kann Compose diese Dienste nicht starten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées depends_on forment une boucle : Compose ne peut donc pas démarrer ces services."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "depends_onのエントリが循環しているため、Composeはこれらのサービスを開始できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "depends_on 항목이 순환을 이루어 Compose가 이 서비스들을 시작할 수 없습니다."
          }
        }
      }
    },
    "The developer team that signed the app." : {
      "comment" : "What an entitlement lets an app do.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
