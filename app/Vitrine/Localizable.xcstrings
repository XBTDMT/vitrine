{
  "sourceLanguage" : "en",
  "strings" : {
    "--follow is not in this build yet; the file still reloads when it changes" : {
      "comment" : "`vitrine` warning; keep --follow as written",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--follow ist in diesem Build noch nicht verfügbar; die Datei wird bei Änderungen trotzdem neu geladen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--follow n’est pas encore disponible dans cette version ; le fichier se recharge quand même lorsqu’il change"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--followはこのビルドではまだ使えません。ファイルは変更されると引き続き再読み込みされます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드에는 아직 --follow가 없습니다. 파일이 변경되면 여전히 다시 로드됩니다"
          }
        }
      }
    },
