    "“%@/Contents.json” is not a regular file and was not read." : {
      "comment" : "Warning on an asset catalog card: the file is a link, folder or device, which the preview does not open.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@/Contents.json“ ist keine normale Datei und wurde nicht gelesen."
