{
  "sourceLanguage" : "en",
  "strings" : {
    "A file step of the update failed." : {
      "comment" : "Why an update check or install failed; one sentence in the update alert.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Dateischritt des Updates ist fehlgeschlagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étape de fichier de la mise à jour a échoué."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートのファイル処理に失敗しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트의 파일 단계가 실패했습니다."
          }
        }
      }
    },
    "it is running from a read-only disk" : {
      "comment" : "Lower-case reason Vitrine cannot replace itself; it fills 'Vitrine can't replace itself here: …'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "es wird von einem schreibgeschützten Volume ausgeführt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "elle s’exécute depuis un disque en lecture seule"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み出し専用のディスクから実行されています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기 전용 디스크에서 실행 중입니다"
          }
        }
      }
    },
    "it is running from a temporary location; move Vitrine to Applications first" : {
      "comment" : "Lower-case reason Vitrine cannot replace itself; it fills 'Vitrine can't replace itself here: …'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "es wird von einem temporären Ort ausgeführt; bewegen Sie Vitrine zuerst in den Ordner „Programme“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "elle s’exécute depuis un emplacement temporaire ; placez d’abord Vitrine dans Applications"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時的な場所から実行されています。先にVitrineを「アプリケーション」フォルダに移動してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "임시 위치에서 실행 중입니다. 먼저 Vitrine을 응용 프로그램 폴더로 옮기세요"
          }
        }
      }
    },
    "The app in the update has a damaged or altered signature, so Vitrine discarded it." : {
      "comment" : "Why an update check or install failed; one sentence in the update alert.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App im Update hat eine beschädigte oder veränderte Signatur, daher hat Vitrine sie verworfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app de la mise à jour a une signature endommagée ou altérée ; Vitrine l’a donc supprimée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデート内のアプリの署名が破損しているか改ざんされているため、Vitrineはそれを破棄しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트에 포함된 앱의 서명이 손상되었거나 변경되어 Vitrine이 해당 앱을 폐기했습니다."
          }
        }
      }
    },
    "The app in the update is %@, not the announced %@." : {
