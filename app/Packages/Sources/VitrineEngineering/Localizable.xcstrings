    "Field %@ defaults to null, but null is not the first type of its union (%@); Avro requires the default to match the first type." : {
      "comment" : "A warning on the API spec preview card (OpenAPI, GraphQL, Protocol Buffers, JSON Schema, Avro); one or two plain sentences ending with a period. null is a type name; keep it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feld %1$@ hat den Standardwert null, aber null ist nicht der erste Typ seiner Union (%2$@); Avro verlangt, dass der Standardwert zum ersten Typ passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Field %1$@ defaults to null, but null is not the first type of its union (%2$@); Avro requires the default to match the first type."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le champ %1$@ a null pour valeur par défaut, mais null n’est pas le premier type de son union (%2$@) ; Avro exige que la valeur par défaut corresponde au premier type."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィールド%1$@のデフォルト値はnullですが、nullはそのユニオン（%2$@）の最初の型ではありません。Avroではデフォルト値が最初の型に一致する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필드 %1$@의 기본값은 null이지만 null이 유니온(%2$@)의 첫 번째 유형이 아닙니다. Avro에서는 기본값이 첫 번째 유형과 일치해야 합니다."
          }
        }
      }
    },
    "Field %@ has a non-null default, but its union starts with null; Avro requires the default to match the first type, so readers reject it." : {
      "comment" : "A warning on the API spec preview card (OpenAPI, GraphQL, Protocol Buffers, JSON Schema, Avro); one or two plain sentences ending with a period. null is a type name; keep it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feld %@ hat einen Standardwert ungleich null, aber seine Union beginnt mit null; Avro verlangt, dass der Standardwert zum ersten Typ passt, daher lehnen Leser ihn ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le champ %@ a une valeur par défaut autre que null, mais son union commence par null ; Avro exige que la valeur par défaut corresponde au premier type, donc les lecteurs la rejettent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィールド%@のデフォルト値はnullではありませんが、そのユニオンはnullで始まっています。Avroではデフォルト値が最初の型に一致する必要があるため、リーダーはこれを拒否します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필드 %@의 기본값은 null이 아니지만 유니온이 null로 시작합니다. Avro에서는 기본값이 첫 번째 유형과 일치해야 하므로 리더가 이를 거부합니다."
          }
        }
      }
    },
    "Field %@ has number %@, outside the allowed 1 to %@." : {
      "comment" : "A warning on the API spec preview card (OpenAPI, GraphQL, Protocol Buffers, JSON Schema, Avro); one or two plain sentences ending with a period. The arguments are a field name and numbers.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feld %1$@ hat die Nummer %2$@, außerhalb des erlaubten Bereichs 1 bis %3$@."
