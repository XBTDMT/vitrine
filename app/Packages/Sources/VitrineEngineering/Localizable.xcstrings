          }
        }
      }
    },
    "Lets the app connect to servers." : {
      "comment" : "What an entitlement lets an app do.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt der App, sich mit Servern zu verbinden."
          }
