    "TestFlight" : {
      "comment" : "Plain name of an entitlement (Apple's service name).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TestFlight"
          }
        },
        "fr" : {
