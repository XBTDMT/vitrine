    "No permissions are set for %@, so their token gets the repository default, which may be write access to everything." : {
      "comment" : "Infra card warning on a GitHub Actions workflow; the argument is a comma-separated list of job ids, kept as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für %@ sind keine Berechtigungen festgelegt, daher erhält ihr Token die Standardeinstellung des Repositorys, möglicherweise Schreibzugriff auf alles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune autorisation n’est définie pour %@ : leur jeton reçoit donc la valeur par défaut du dépôt, qui peut être un accès en écriture à tout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に権限が設定されていないため、トークンにはリポジトリのデフォルトが適用されます。これはすべてへの書き込みアクセスである可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 권한이 설정되지 않아 토큰에 저장소 기본값이 적용되며, 이는 모든 항목에 대한 쓰기 권한일 수 있습니다."
          }
        }
      }
    },
