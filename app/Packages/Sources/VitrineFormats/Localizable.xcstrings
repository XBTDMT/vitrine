        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conteneur s’exécute en mode privilégié, avec un accès complet à l’hôte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナが特権モードで実行され、ホストにフルアクセスできます。"
