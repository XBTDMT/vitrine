    "Stopped after %@ s; in a compressed stream each name is reached only by decompressing what comes before it" : {
      "comment" : "Why the archive listing is partial. The argument is a number of seconds.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach %@ s gestoppt; in einem komprimierten Datenstrom ist jeder Name nur erreichbar, indem alles davor entpackt wird"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté après %@ s ; dans un flux compressé, chaque nom n’est atteint qu’en décompressant ce qui le précède"
