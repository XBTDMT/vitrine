          }
        }
      }
    },
    "Installing from it repeats exactly; Vitrine checks no registry or vulnerability list." : {
      "comment" : "Calm verdict reason for a lockfile.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
