{
  "sourceLanguage" : "en",
  "strings" : {
    "'%@' is a table defined by a header; dotted keys cannot add to it here" : {
      "comment" : "A syntax or reading problem in a structured file (JSON, YAML, TOML, XML, property list), shown in the preview; lower-case, no final period. Quoted characters, tokens and code stay as they are.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‚%@‘ ist eine durch einen Header definierte Tabelle; Punktschlüssel können hier nichts hinzufügen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' est une table définie par un en-tête ; les clés à points ne peuvent pas y ajouter d’éléments ici"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'はヘッダで定義されたテーブルです。ここでドット付きキーを追加することはできません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'은(는) 헤더로 정의된 테이블이므로 여기서 점 표기 키로 추가할 수 없음"
          }
        }
      }
    },
    "'%@' is already a value, not a table" : {
