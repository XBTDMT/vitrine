    "Enum %@ defaults to %@, which is not one of its symbols." : {
      "comment" : "A warning on the API spec preview card (OpenAPI, GraphQL, Protocol Buffers, JSON Schema, Avro); one or two plain sentences ending with a period. The arguments are an enum name and a symbol.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enum %1$@ hat den Standardwert %2$@, der keines seiner Symbole ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enum %1$@ defaults to %2$@, which is not one of its symbols."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enum %1$@ a pour valeur par défaut %2$@, qui ne fait pas partie de ses symboles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "enum %1$@のデフォルト値%2$@は、そのシンボルのいずれでもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "enum %1$@의 기본값 %2$@은(는) 해당 심볼에 없습니다."
          }
        }
      }
    },
    "Enum %@ gives %@ and %@ the same number %@ without allow_alias; protoc rejects this." : {
      "comment" : "A warning on the API spec preview card (OpenAPI, GraphQL, Protocol Buffers, JSON Schema, Avro); one or two plain sentences ending with a period. allow_alias is an option name; keep it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enum %1$@ gibt %2$@ und %3$@ ohne allow_alias dieselbe Nummer %4$@; protoc lehnt das ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enum %1$@ gives %2$@ and %3$@ the same number %4$@ without allow_alias; protoc rejects this."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enum %1$@ attribue à %2$@ et %3$@ le même numéro %4$@ sans allow_alias ; protoc le rejette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "enum %1$@で、%2$@と%3$@にallow_aliasなしで同じ番号%4$@が割り当てられています。protocはこれを拒否します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "enum %1$@이(가) allow_alias 없이 %2$@와(과) %3$@에 같은 번호 %4$@을(를) 지정합니다. protoc는 이를 거부합니다."
          }
        }
      }
    },
    "Enum %@ starts with %@; proto3 needs the first value to be 0." : {
      "comment" : "A warning on the API spec preview card (OpenAPI, GraphQL, Protocol Buffers, JSON Schema, Avro); one or two plain sentences ending with a period. The arguments are an enum name and its first value such as UNKNOWN = 1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enum %1$@ beginnt mit %2$@; proto3 verlangt 0 als ersten Wert."
