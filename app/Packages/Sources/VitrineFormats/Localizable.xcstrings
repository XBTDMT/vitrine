        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 인용 키가 여러 번 쓰였으며, LaTeX는 각각 하나의 항목만 사용합니다: %@."
          }
        }
      }
    },
    "These string macros are used but never defined: %@." : {
      "comment" : "Warning on a BibTeX card; the argument is one or more @string macro names.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
