          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces pièces jointes peuvent exécuter du code à l’ouverture : %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の添付ファイルは開くとコードを実行できます: %@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 첨부 파일은 열 때 코드를 실행할 수 있습니다: %@."
          }
        }
      }
    },
    "These citation keys are used more than once, and LaTeX will use only one entry for each: %@." : {
      "comment" : "Warning on a BibTeX card; the argument is one or more citation keys.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zitierschlüssel werden mehrfach verwendet, und LaTeX nutzt für jeden nur einen Eintrag: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces clés de citation sont utilisées plusieurs fois, et LaTeX n’utilisera qu’une entrée pour chacune : %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の引用キーが複数回使われていますが、LaTeXはそれぞれ1つのエントリしか使いません: %@。"
