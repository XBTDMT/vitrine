    },
    "Vitrine looks for the claude command in your shell and in Claude Code’s usual places. Install Claude Code, then connect again." : {
      "comment" : "Alert text when the claude command is not found; keep the command name claude",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrine sucht den Befehl claude in Ihrer Shell und an den üblichen Orten von Claude Code. Installieren Sie Claude Code und verbinden Sie dann erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrine cherche la commande claude dans votre shell et aux emplacements habituels de Claude Code. Installez Claude Code, puis connectez à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VitrineはシェルとClaude Codeの通常の場所でclaudeコマンドを探します。Claude Codeをインストールしてから、もう一度接続してください。"
          }
        },
        "ko" : {
