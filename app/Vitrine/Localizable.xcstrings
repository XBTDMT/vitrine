          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitrine은 %@에서 이 텍스트를 빼고 다른 것은 바꾸지 않습니다."
          }
        }
      }
    },
    "Vitrine takes this text out of %@ and changes nothing else. The menu bar stops listing Claude Code sessions." : {
      "comment" : "Alert text; the settings file's path",
      "localizations" : {
        "de" : {
          "stringUnit" : {
