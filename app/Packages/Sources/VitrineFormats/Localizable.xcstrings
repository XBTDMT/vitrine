    "The sender's name shows the address %@ but the message comes from %@: a common phishing trick." : {
      "comment" : "Warning on an email card; the first argument is the address written in the sender's name, the second the real sender address.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Absendername zeigt die Adresse %1$@, aber die Nachricht kommt von %2$@: ein gängiger Phishing-Trick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The sender's name shows the address %1$@ but the message comes from %2$@: a common phishing trick."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom de l’expéditeur affiche l’adresse %1$@ mais le message vient de %2$@ : une ruse courante d’hameçonnage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "差出人の名前には%1$@と表示されていますが、メッセージは%2$@から送られています。よくあるフィッシングの手口です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보낸 사람 이름에는 %1$@ 주소가 표시되지만 메시지는 %2$@에서 왔습니다. 흔한 피싱 수법입니다."
          }
        }
      }
    },
    "The superblock is damaged: its address and length sizes are not 2, 4 or 8 bytes." : {
      "comment" : "HDF5 warning.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
