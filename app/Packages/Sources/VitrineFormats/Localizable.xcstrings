        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨테이너가 특권 모드로 실행되어 호스트에 완전히 접근할 수 있습니다."
          }
        }
      }
    },
    "The container shares the host's network." : {
      "comment" : "Warning on an MCP server run with docker.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Container teilt das Netzwerk des Hosts."
