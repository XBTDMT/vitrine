    "%@ archives inside are larger than Vitrine opens in place." : {
      "comment" : "Archive safety card: one finding's sentence (more than one; the argument is the count).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ enthaltene Archive sind größer, als Vitrine direkt öffnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ archives internes dépassent la taille que Vitrine ouvre sur place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部のアーカイブのうち%@個は、Vitrineがその場で開けるサイズを超えています。"
