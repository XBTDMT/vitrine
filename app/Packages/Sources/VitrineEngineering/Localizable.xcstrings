          }
        }
      }
    },
    "Lets people sign in with their Apple Account." : {
      "comment" : "What an entitlement lets an app do.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht die Anmeldung mit dem Apple Account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet de se connecter avec son compte Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleアカウントでサインインできるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 계정으로 로그인할 수 있게 합니다."
          }
        }
      }
    },
    "lets the app attach to and control other processes as a debugger" : {
      "comment" : "Why a hardened-runtime entitlement matters; follows “Hardened-runtime exception (key):”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erlaubt der App, sich als Debugger an andere Prozesse anzuhängen und sie zu steuern"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "permet à l’app de s’attacher à d’autres processus et de les contrôler en tant que débogueur"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがデバッガとしてほかのプロセスにアタッチし、制御できるようになります"
