{
  "_comment": "Single source of truth for every file type Vitrine previews. tools/gen_utis.py turns this into the host app's exported/imported UTI declarations and each extension's QLSupportedContentTypes. Identifiers are ours (io.github.xbtdmt.vitrine.*) and never another app's.",
  "prefix": "io.github.xbtdmt.vitrine",
  "exported": [
    {"id": "csr", "desc": "Certificate Signing Request", "conforms": ["public.data"], "ext": ["csr"]},
    {"id": "ssh-public-key", "desc": "SSH Public Key", "conforms": ["public.plain-text"], "ext": ["pub"]},
    {"id": "mdx", "desc": "MDX Document", "conforms": ["public.plain-text", "net.daringfireball.markdown"], "ext": ["mdx"]},
    {"id": "mdc", "desc": "MDC Document", "conforms": ["public.plain-text", "net.daringfireball.markdown"], "ext": ["mdc"]},
    {"id": "qmd", "desc": "Quarto Document", "conforms": ["public.plain-text", "net.daringfireball.markdown"], "ext": ["qmd"]},
    {"id": "rmd", "desc": "R Markdown Document", "conforms": ["public.plain-text", "net.daringfireball.markdown"], "ext": ["rmd"]},
    {"id": "env", "desc": "Environment File", "conforms": ["public.plain-text"], "ext": ["env"]},
    {"id": "conf", "desc": "Configuration File", "conforms": ["public.plain-text"], "ext": ["conf", "cfg"]},
    {"id": "properties", "desc": "Properties File", "conforms": ["public.plain-text"], "ext": ["properties"]},
    {"id": "log", "desc": "Log File", "conforms": ["public.plain-text"], "ext": ["log"]},
    {"id": "nfo", "desc": "NFO File", "conforms": ["public.plain-text"], "ext": ["nfo"]},
    {"id": "patch", "desc": "Patch File", "conforms": ["public.plain-text"], "ext": ["patch", "diff"]},
    {"id": "csv", "desc": "CSV Document", "conforms": ["public.comma-separated-values-text"], "ext": ["csv"]},
    {"id": "tsv", "desc": "TSV Document", "conforms": ["public.tab-separated-values-text"], "ext": ["tsv", "tab"]},
    {"id": "sqlite", "desc": "SQLite Database", "conforms": ["public.data", "public.database"], "ext": ["sqlite", "sqlite3", "db", "db3"]},
    {"id": "parquet", "desc": "Apache Parquet File", "conforms": ["public.data"], "ext": ["parquet"]},
    {"id": "arrow", "desc": "Apache Arrow File", "conforms": ["public.data"], "ext": ["arrow"]},
    {"id": "arrows", "desc": "Apache Arrow Stream", "conforms": ["public.data"], "ext": ["arrows"]},
    {"id": "feather", "desc": "Feather File", "conforms": ["public.data"], "ext": ["feather"]},
    {"id": "ipa", "desc": "iOS App Archive", "conforms": ["public.zip-archive"], "ext": ["ipa"]},
    {"id": "apk", "desc": "Android Package", "conforms": ["public.zip-archive"], "ext": ["apk"]},
    {"id": "iso", "desc": "ISO Image", "conforms": ["public.data", "public.disk-image"], "ext": ["iso"]},
    {"id": "torrent", "desc": "Torrent File", "conforms": ["public.data"], "ext": ["torrent"]},
    {"id": "rpm", "desc": "RPM Package", "conforms": ["public.data", "public.archive"], "ext": ["rpm"]},
    {"id": "deb", "desc": "Debian Package", "conforms": ["public.data", "public.archive"], "ext": ["deb", "udeb"]},
    {"id": "ear", "desc": "Enterprise Application Archive", "conforms": ["public.zip-archive"], "ext": ["ear"]},
    {"id": "provisioningprofile", "desc": "Provisioning Profile", "conforms": ["public.data"], "ext": ["provisionprofile", "mobileprovision"]},
    {"id": "skill", "desc": "Agent Skill Folder", "conforms": ["public.folder"], "ext": []},
    {"id": "ipynb", "desc": "Jupyter Notebook", "conforms": ["public.json"], "ext": ["ipynb"]},
    {"id": "woff", "desc": "WOFF Web Font", "conforms": ["public.font"], "ext": ["woff"]},
    {"id": "woff2", "desc": "WOFF 2 Web Font", "conforms": ["public.font"], "ext": ["woff2"]},
    {"id": "apng", "desc": "Animated PNG Image", "conforms": ["public.png"], "ext": ["apng"]},
    {"id": "jsonl", "desc": "JSON Lines", "conforms": ["public.plain-text"], "ext": ["jsonl", "ndjson"]}
  ],
  "imported": [
    {"id": "org.sqlite.database", "desc": "SQLite Database", "conforms": ["public.data", "public.database"], "ext": ["sqlite", "sqlite3", "db"]},
    {"id": "org.textbundle.package", "desc": "TextBundle", "conforms": ["com.apple.package"], "ext": ["textbundle"]},
    {"id": "org.python.restructuredtext", "desc": "reStructuredText", "conforms": ["public.plain-text"], "ext": ["rst"]},
    {"id": "org.asciidoc.asciidoc", "desc": "AsciiDoc", "conforms": ["public.plain-text"], "ext": ["adoc", "asciidoc"]},
    {"id": "org.orgmode.org", "desc": "Org Mode", "conforms": ["public.plain-text"], "ext": ["org"]},
    {"id": "io.toml", "desc": "TOML", "conforms": ["public.plain-text"], "ext": ["toml"]},
    {"id": "com.google.dart-source", "desc": "Dart Source", "conforms": ["public.source-code"], "ext": ["dart"]},
    {"id": "org.scala-lang.scala-source", "desc": "Scala Source", "conforms": ["public.source-code"], "ext": ["scala", "sc"]},
    {"id": "org.haskell.haskell-source", "desc": "Haskell Source", "conforms": ["public.source-code"], "ext": ["hs", "lhs"]},
    {"id": "org.clojure.clojure-source", "desc": "Clojure Source", "conforms": ["public.source-code"], "ext": ["clj", "cljs", "cljc", "edn"]},
    {"id": "org.elixir-lang.elixir-source", "desc": "Elixir Source", "conforms": ["public.source-code"], "ext": ["ex", "exs"]},
    {"id": "org.ocaml.ocaml-source", "desc": "OCaml Source", "conforms": ["public.source-code"], "ext": ["ml", "mli"]},
    {"id": "net.common-lisp.lisp", "desc": "Lisp Source", "conforms": ["public.source-code"], "ext": ["lisp", "lsp", "cl", "el"]},
    {"id": "com.microsoft.fsharp-source", "desc": "F# Source", "conforms": ["public.source-code"], "ext": ["fs", "fsx", "fsi"]},
    {"id": "org.lesscss.less", "desc": "Less Stylesheet", "conforms": ["public.source-code"], "ext": ["less"]},
    {"id": "org.latex-project.latex", "desc": "LaTeX", "conforms": ["public.plain-text"], "ext": ["tex", "latex", "sty", "cls"]},
    {"id": "org.vuejs.vue", "desc": "Vue Component", "conforms": ["public.source-code"], "ext": ["vue"]},
    {"id": "com.microsoft.typescript.tsx", "desc": "TSX Source", "conforms": ["public.source-code"], "ext": ["tsx"]},
    {"id": "com.sass-lang.sass", "desc": "Sass Stylesheet", "conforms": ["public.source-code"], "ext": ["sass", "scss"]},
    {"id": "com.microsoft.csharp-source", "desc": "C# Source", "conforms": ["public.source-code"], "ext": ["cs"]},
    {"id": "org.r-project.r-source", "desc": "R Source", "conforms": ["public.source-code"], "ext": ["r", "R"]},
    {"id": "org.codehaus.groovy-source", "desc": "Groovy Source", "conforms": ["public.source-code"], "ext": ["groovy", "gradle"]},
    {"id": "org.erlang.erlang-source", "desc": "Erlang Source", "conforms": ["public.source-code"], "ext": ["erl", "hrl"]},
    {"id": "org.kotlinlang.kotlin-source", "desc": "Kotlin Source", "conforms": ["public.source-code"], "ext": ["kt", "kts"]},
    {"id": "org.golang.go-source", "desc": "Go Source", "conforms": ["public.source-code"], "ext": ["go"]},
    {"id": "org.rust-lang.rust-source", "desc": "Rust Source", "conforms": ["public.source-code"], "ext": ["rs"]},
    {"id": "org.lua", "desc": "Lua Source", "conforms": ["public.source-code"], "ext": ["lua"]},
    {"id": "public.yaml", "desc": "YAML", "conforms": ["public.plain-text"], "ext": ["yml", "yaml"]}
  ],
  "extensions": {
    "Markdown": ["net.daringfireball.markdown", "public.markdown", "$mdx", "$mdc", "$qmd", "$rmd", "org.textbundle.package", "org.python.restructuredtext", "org.asciidoc.asciidoc", "org.orgmode.org", "public.svg-image"],
    "Code": ["public.swift-source", "public.objective-c-source", "public.objective-c-plus-plus-source", "public.c-header", "public.c-plus-plus-header", "public.c-source", "public.c-plus-plus-source", "public.python-script", "public.ruby-script", "public.php-script", "public.perl-script", "public.shell-script", "public.bash-script", "public.zsh-script", "org.lua", "com.netscape.javascript-source", "public.jsx-source", "com.microsoft.typescript", "com.microsoft.typescript.tsx", "com.sun.java-source", "org.kotlinlang.kotlin-source", "org.golang.go-source", "org.rust-lang.rust-source", "com.sass-lang.sass", "org.iso.sql", "com.google.dart-source", "org.scala-lang.scala-source", "org.haskell.haskell-source", "org.clojure.clojure-source", "org.elixir-lang.elixir-source", "org.ocaml.ocaml-source", "net.common-lisp.lisp", "com.microsoft.fsharp-source", "org.lesscss.less", "org.latex-project.latex", "org.vuejs.vue", "com.microsoft.csharp-source", "org.r-project.r-source", "org.codehaus.groovy-source", "org.erlang.erlang-source", "com.apple.applescript.text", "com.apple.log", "public.assembly-source", "public.yaml", "public.toml", "io.toml", "$env", "$conf", "$properties", "$log", "$nfo", "$patch", "public.patch-file", "public.json", "public.xml", "com.apple.property-list", "com.apple.xml-property-list", "com.apple.binary-property-list", "$ipynb", "$jsonl"],
    "Data": ["public.comma-separated-values-text", "$csv", "public.tab-separated-values-text", "$tsv", "org.sqlite.database", "$sqlite", "$parquet", "$arrow", "$arrows", "$feather", "org.openxmlformats.spreadsheetml.sheet"],
    "Packages": ["public.x509-certificate", "$csr", "$ssh-public-key", "public.zip-archive", "com.pkware.zip-archive", "public.tar-archive", "org.gnu.gnu-zip-archive", "public.bzip2-archive", "com.apple.application-bundle", "$ipa", "$apk", "com.apple.installer-package-archive", "$provisioningprofile", "com.apple.mobileconfig", "com.apple.disk-image", "$iso", "$torrent", "$skill", "com.rarlab.rar-archive", "org.7-zip.7-zip-archive", "org.tukaani.xz-archive", "org.tukaani.tar-xz-archive", "com.facebook.zstandard-archive", "com.facebook.zstandard-tar-archive", "public.lz4-archive", "org.tukaani.lzma-archive", "public.lzip-archive", "public.lzip-tar-archive", "public.z-archive", "public.tar-bzip2-archive", "org.gnu.gnu-zip-tar-archive", "public.iso-image", "public.cpio-archive", "com.apple.xar-archive", "com.microsoft.cab", "public.archive.lha", "com.sun.java-archive", "com.sun.web-application-archive", "$ear", "$rpm", "$deb", "org.bittorrent.torrent", "com.apple.itunes.ipa", "public.archive.apk", "com.apple.disk-image-udif", "$woff", "$woff2", "$apng"],
    "Folders": ["public.folder"]
  },
  "thumbnailExtensions": {
    "Thumbnails": ["net.daringfireball.markdown", "public.markdown", "$mdx", "$mdc", "$qmd", "$rmd", "org.python.restructuredtext", "org.asciidoc.asciidoc", "org.orgmode.org", "public.swift-source", "public.objective-c-source", "public.objective-c-plus-plus-source", "public.c-header", "public.c-plus-plus-header", "public.c-source", "public.c-plus-plus-source", "public.python-script", "public.ruby-script", "public.php-script", "public.perl-script", "public.shell-script", "public.bash-script", "public.zsh-script", "org.lua", "com.netscape.javascript-source", "public.jsx-source", "com.microsoft.typescript", "com.microsoft.typescript.tsx", "com.sun.java-source", "org.kotlinlang.kotlin-source", "org.golang.go-source", "org.rust-lang.rust-source", "com.sass-lang.sass", "org.iso.sql", "com.google.dart-source", "org.scala-lang.scala-source", "org.haskell.haskell-source", "org.clojure.clojure-source", "org.elixir-lang.elixir-source", "org.ocaml.ocaml-source", "net.common-lisp.lisp", "com.microsoft.fsharp-source", "org.lesscss.less", "org.latex-project.latex", "org.vuejs.vue", "com.microsoft.csharp-source", "org.r-project.r-source", "org.codehaus.groovy-source", "org.erlang.erlang-source", "com.apple.applescript.text", "com.apple.log", "public.assembly-source", "public.yaml", "public.toml", "io.toml", "$env", "$conf", "$properties", "$log", "$nfo", "$patch", "public.patch-file", "public.json", "public.xml", "com.apple.property-list", "com.apple.xml-property-list", "com.apple.binary-property-list", "$ipynb", "$jsonl", "public.comma-separated-values-text", "$csv", "public.tab-separated-values-text", "$tsv"]
  },
  "spotlightImporter": {
    "_comment": "S-19, X-8: the types Vitrine's Spotlight importer reads (SpotlightText): databases, column files, notebooks and archives. Markdown and code are left to Apple's text importers; a type Apple already imports keeps Apple's importer.",
    "types": ["$sqlite", "org.sqlite.database", "$parquet", "$arrow", "$arrows", "$feather", "$ipynb",
              "public.zip-archive", "com.pkware.zip-archive", "public.tar-archive", "org.gnu.gnu-zip-tar-archive", "public.tar-bzip2-archive",
              "com.rarlab.rar-archive", "org.7-zip.7-zip-archive", "org.tukaani.xz-archive", "org.tukaani.tar-xz-archive",
