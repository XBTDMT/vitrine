{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” is %@; archives inside archives open up to %@" : {
      "comment" : "Why a member inside an archive cannot be opened. A path, its size, then the size limit.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist %2$@ groß; Archive in Archiven werden bis %3$@ geöffnet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” is %2$@; archives inside archives open up to %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » fait %2$@ ; les archives imbriquées s’ouvrent jusqu’à %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は%2$@です。アーカイブ内のアーカイブは%3$@まで開けます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”의 크기: %2$@. 아카이브 안의 아카이브는 최대 %3$@까지 열 수 있습니다"
          }
        }
      }
    },
    "“%@” is larger than that; archives inside archives open up to %@" : {
      "comment" : "Why a member inside an archive cannot be opened. The first argument is a path, the second a size limit.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist größer; Archive in Archiven werden bis %2$@ geöffnet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” is larger than that; archives inside archives open up to %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » est plus grand ; les archives imbriquées s’ouvrent jusqu’à %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」はそれより大きいサイズです。アーカイブ内のアーカイブは%2$@まで開けます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”이(가) 그보다 큽니다. 아카이브 안의 아카이브는 최대 %2$@까지 열 수 있습니다"
          }
        }
      }
    },
    "“%@” is not in the archive" : {
      "comment" : "Why a member inside an archive cannot be opened. The argument is a path.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist nicht im Archiv"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne figure pas dans l’archive"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はアーカイブ内にありません"
