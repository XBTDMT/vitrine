    "Terraform writes state values in plain text: this file holds %@; treat it as a secret." : {
      "comment" : "Infra card warning on a Terraform state file; the argument is a list such as '2 sensitive attributes and 1 sensitive output'. Values are never shown.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terraform schreibt State-Werte im Klartext: Diese Datei enthält %@; behandeln Sie sie als Geheimnis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terraform écrit les valeurs de l’état en clair : ce fichier contient %@ ; traitez-le comme un secret."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terraformはステートの値をプレーンテキストで書き込みます。このファイルには%@が含まれているため、秘密情報として扱ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terraform은 상태 값을 일반 텍스트로 기록합니다. 이 파일에는 %@이(가) 들어 있으므로 비밀 정보로 취급하세요."
          }
        }
      }
    },
    "Test mode for a file provider extension." : {
      "comment" : "What an entitlement lets an app do.",
      "localizations" : {
        "de" : {
