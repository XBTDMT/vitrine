                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld個のドメインに暗号化されていないHTTPが許可されています（%2$@）。アプリがそれらとやり取りする内容は暗号化されません。"
