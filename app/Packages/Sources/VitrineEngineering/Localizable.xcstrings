    "Defined more than once: %@. A GraphQL server rejects a schema like this; additions belong in extend." : {
      "comment" : "A warning on the API spec preview card (OpenAPI, GraphQL, Protocol Buffers, JSON Schema, Avro); one or two plain sentences ending with a period. The argument is a list of type names; extend is a GraphQL keyword.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrfach definiert: %@. Ein GraphQL-Server lehnt ein solches Schema ab; Ergänzungen gehören in extend."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défini plusieurs fois : %@. Un serveur GraphQL rejette un tel schéma ; les ajouts doivent passer par extend."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数回定義されています：%@。GraphQLサーバはこのようなスキーマを拒否します。追加はextendで行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 번 정의됨: %@. GraphQL 서버는 이런 스키마를 거부합니다. 추가 사항은 extend에 넣어야 합니다."
          }
        }
      }
    },
    "Defined more than once: %@. Avro rejects a schema that redefines a name." : {
      "comment" : "A warning on the API spec preview card (OpenAPI, GraphQL, Protocol Buffers, JSON Schema, Avro); one or two plain sentences ending with a period. The argument is a list of type names.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrfach definiert: %@. Avro lehnt ein Schema ab, das einen Namen neu definiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défini plusieurs fois : %@. Avro rejette un schéma qui redéfinit un nom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数回定義されています：%@。Avroは名前を再定義するスキーマを拒否します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 번 정의됨: %@. Avro는 이름을 다시 정의하는 스키마를 거부합니다."
          }
        }
      }
    },
