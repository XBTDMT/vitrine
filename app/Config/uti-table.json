              "public.lzip-archive", "public.lzip-tar-archive", "public.z-archive", "public.cpio-archive", "com.microsoft.cab",
              "public.archive.lha", "com.sun.java-archive", "$rpm", "$deb", "public.iso-image", "$iso"]
  }
