          }
        }
      }
    },
    "This 3MF package has no model part (%@ is missing)." : {
      "comment" : "3D model card warning. Arguments are filled in at run time.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses 3MF-Paket hat keinen Modellteil (%@ fehlt)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce paquet 3MF n’a pas de partie modèle (%@ manque)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この3MFパッケージにモデルパーツがありません（%@がありません）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 3MF 패키지에 모델 파트가 없습니다(%@ 없음)."
          }
        }
      }
    },
    "This array holds Python objects. NumPy can only load it by unpickling, which can run code; open it only if you trust where it came from." : {
      "comment" : "NumPy danger warning; NumPy is a product name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Array enthält Python-Objekte. NumPy kann es nur durch Unpickling laden, was Code ausführen kann; öffne es nur, wenn du seiner Herkunft vertraust."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce tableau contient des objets Python. NumPy ne peut le charger qu’en le désérialisant (unpickling), ce qui peut exécuter du code ; ne l’ouvrez que si vous faites confiance à sa provenance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この配列にはPythonオブジェクトが含まれています。NumPyはアンピックルでしか読み込めず、その際にコードが実行される可能性があります。入手元を信頼できる場合にのみ開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 배열에 Python 객체가 들어 있습니다. NumPy는 언피클링으로만 불러올 수 있고, 이때 코드가 실행될 수 있습니다. 출처를 신뢰할 때만 여세요."
          }
        }
      }
    },
    "This book contains scripts (EPUB 3 scripting). Vitrine never runs them." : {
      "comment" : "Book or comic card warning.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Buch enthält Skripte (EPUB 3-Scripting). Vitrine führt sie nie aus."
