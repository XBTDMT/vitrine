                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Übersetzungen verwenden Platzhalter, die nicht zum Ausgangstext passen (zuerst: „%@“ in %@). Wenn die App sie füllt, kann sie falsche Werte zeigen oder abstürzen."
