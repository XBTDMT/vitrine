    "“%@” has no table or sheet named “%@”. It has %@." : {
      "comment" : "Shortcuts error for Extract Table. Arguments: the file's name, the name asked for, then the names it has as a list.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ enthält keine Tabelle und kein Blatt namens „%2$@“. Vorhanden: %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” has no table or sheet named “%2$@”. It has %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » ne contient aucune table ni feuille nommée « %2$@ ». Disponibles : %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」に「%2$@」という名前のテーブルまたはシートはありません。あるのは%3$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”에 “%2$@”(이)라는 테이블이나 시트가 없습니다. 있는 항목: %3$@."
          }
        }
      }
    },
    "“%@” has no tables or sheets to read." : {
      "comment" : "Shortcuts error for Extract Table: an empty database or workbook; the argument is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ enthält keine Tabellen oder Blätter zum Lesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne contient aucune table ni feuille à lire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」には読み取れるテーブルやシートがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에 읽을 테이블이나 시트가 없습니다."
          }
        }
      }
    },
    "“%@” is not a table. Extract Table reads CSV, TSV, SQLite, Parquet, Arrow, Feather and Excel files." : {
      "comment" : "Shortcuts error for Extract Table; the argument is the file's name. Format names stay as they are.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist keine Tabelle. „Tabelle extrahieren“ liest CSV-, TSV-, SQLite-, Parquet-, Arrow-, Feather- und Excel-Dateien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas une table. Extraire une table lit les fichiers CSV, TSV, SQLite, Parquet, Arrow, Feather et Excel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はテーブルではありません。「テーブルを抽出」で読めるのはCSV、TSV、SQLite、Parquet、Arrow、Feather、Excelファイルです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 테이블이 아닙니다. ‘테이블 추출’은 CSV, TSV, SQLite, Parquet, Arrow, Feather, Excel 파일을 읽습니다."
          }
        }
      }
    },
    "“%@” is not an app, installer package, disk image or Mach-O binary, so it carries no code signature to check." : {
      "comment" : "Shortcuts error for Check Signature; the argument is the file's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist keine App, kein Installationspaket, kein Image und keine Mach-O-Binärdatei und trägt daher keine Codesignatur, die sich prüfen ließe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est ni une app, ni un paquet d’installation, ni une image disque, ni un binaire Mach-O ; il ne porte donc aucune signature de code à vérifier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はアプリ、インストーラパッケージ、ディスクイメージ、Mach-Oバイナリのいずれでもないため、確認するコード署名がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 앱, 설치 패키지, 디스크 이미지, Mach-O 바이너리가 아니므로 확인할 코드 서명이 없습니다."
          }
        }
      }
    },
    "/usr/local/bin/vitrine needs your password, so Vitrine does not do it. Run this in Terminal:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/usr/local/bin/vitrine erfordert Ihr Passwort, daher erledigt Vitrine das nicht. Führen Sie dies im Terminal aus:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/usr/local/bin/vitrine nécessite votre mot de passe ; Vitrine ne le fait donc pas. Exécutez ceci dans Terminal :"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/usr/local/bin/vitrineにはパスワードが必要なため、Vitrineは実行しません。ターミナルで次を実行してください："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/usr/local/bin/vitrine에는 암호가 필요하므로 Vitrine이 직접 설치하지 않습니다. 터미널에서 다음을 실행하세요:"
          }
        }
      }
    },
