    },
    "“%@” names %lld files that are not in its folder (%@). Xcode reports this when building, and the app goes without them." : {
      "comment" : "Warning on an asset catalog card. Arguments: the asset's name, how many files are missing, then their names.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "„%@“ nennt %lld Datei, die nicht in seinem Ordner liegt (%@). Xcode meldet das beim Build, und sie fehlt in der App."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "„%@“ nennt %lld Dateien, die nicht in seinem Ordner liegen (%@). Xcode meldet das beim Build, und sie fehlen in der App."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "“%@” names %lld file that is not in its folder (%@). Xcode reports this when building, and the app goes without it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "“%@” names %lld files that are not in its folder (%@). Xcode reports this when building, and the app goes without them."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "« %@ » cite %lld fichier absent de son dossier (%@). Xcode le signale à la compilation, et l’app s’en passe."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "« %@ » cite %lld fichiers absents de son dossier (%@). Xcode le signale à la compilation, et l’app s’en passe."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は、フォルダにない%2$lld個のファイル（%3$@）を指定しています。Xcodeはビルド時にこれを報告し、アプリにはそれらのファイルが含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”이(가) 폴더에 없는 파일 %2$lld개(%3$@)를 지정합니다. Xcode는 빌드할 때 이를 보고하며, 앱에는 해당 파일이 포함되지 않습니다."
          }
        }
      }
    },
    "“%@/Contents.json” is %lld bytes, more than the preview reads." : {
