      }
    },
    "It connects over plain http to %@, so traffic and tokens travel unencrypted." : {
      "comment" : "Warning on an MCP server. The argument is a host name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verbindet sich über unverschlüsseltes http mit %@, daher werden Daten und Token unverschlüsselt übertragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se connecte en http non chiffré à %@ : le trafic et les jetons circulent en clair."
