{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” defines no colors." : {
      "comment" : "Warning on an asset catalog card; the argument is a color set's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ definiert keine Farben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne définit aucune couleur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」にはカラーが定義されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에 정의된 색상이 없습니다."
          }
        }
      }
    },
    "“%@” has no Contents.json, so Xcode does not know what its files are for." : {
      "comment" : "Warning on an asset catalog card; the argument is the asset folder's path. Contents.json is a file name and stays as is.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ hat keine Contents.json, daher weiß Xcode nicht, wofür die Dateien darin gedacht sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’a pas de Contents.json : Xcode ne sait donc pas à quoi servent ses fichiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」にContents.jsonがないため、Xcodeはそのファイルの用途を判断できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에 Contents.json이 없어 Xcode가 파일의 용도를 알 수 없습니다."
          }
        }
      }
    },
    "“%@” has no data files assigned, so it is empty in the app." : {
      "comment" : "Warning on an asset catalog card; the argument is a data set's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ sind keine Datendateien zugewiesen, daher ist es in der App leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun fichier de données n’est attribué à « %@ » : il est donc vide dans l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」にはデータファイルが割り当てられていないため、アプリ内では空になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에 할당된 데이터 파일이 없어 앱에서는 비어 있습니다."
          }
        }
      }
    },
    "“%@” has no image files assigned, so it is empty in the app." : {
      "comment" : "Warning on an asset catalog card; the argument is an image set's or app icon's name.",
