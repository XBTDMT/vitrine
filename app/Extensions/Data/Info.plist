				<string>io.github.xbtdmt.vitrine.arrows</string>
				<string>io.github.xbtdmt.vitrine.feather</string>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
			</array>
			<key>QLSupportsSearchableItems</key>
