        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 서버에 연결할 수 있게 합니다."
          }
        }
      }
    },
    "lets the app create executable memory without code-signing checks" : {
      "comment" : "Why a hardened-runtime entitlement matters; follows “Hardened-runtime exception (key):”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erlaubt der App, ausführbaren Speicher ohne Prüfung der Codesignatur zu erzeugen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "permet à l’app de créer de la mémoire exécutable sans vérification de la signature du code"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがコード署名のチェックなしで実行可能メモリを作成できるようになります"
