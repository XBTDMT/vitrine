        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자격 증명으로 보이는 값이 여기에서 가려졌습니다. Vitrine은 이 값을 절대 표시하지 않습니다."
          }
        }
      }
    },
