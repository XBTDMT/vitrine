    "Counted with a tokenizer." : {
      "comment" : "Token meter foot: an exact count from a counter this version does not know.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Tokenizer gezählt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compté avec un tokeniseur."
